# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/avenqora-bank
POSTGRES_PASSWORD=replace-this-for-docker-compose

# ─── Session / Security ──────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 48 (minimum 32 characters)
SESSION_SECRET=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://your-domain.example
# Optional additional trusted front-end origins, comma-separated.
CORS_ORIGINS=

# ─── Email / SMTP (optional; required for outbound email only) ─────────────────
# Credentials are deployment secrets. They are never included in this archive.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The website email identities below are non-secret configuration exported for this website.
# SMTP_FROM is retained for provider compatibility; the Main System Email is authoritative.
SMTP_FROM=
MAIN_SYSTEM_EMAIL=
MAIN_SYSTEM_EMAIL_SENDER_NAME=
CUSTOMER_SUPPORT_EMAIL=
CUSTOMER_SUPPORT_EMAIL_SENDER_NAME=

# ─── Private customer document storage ───────────────────────────────────────
# Local development default. Hosted deployments must set this to a durable mounted volume path.
# Ephemeral container filesystems can permanently lose customer KYC documents.
UPLOAD_DIR=./data/uploads

# ─── Customer Support Widget ──────────────────────────────────────────────────
# The embed code is pre-configured in client/src/config.ts from your export.
# To update the widget: edit WEBSITE_CONFIG.liveChatCode in config.ts.
# The widget loads from the third-party CDN directly — no server config needed.
