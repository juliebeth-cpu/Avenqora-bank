# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/avenqora-bank
POSTGRES_PASSWORD=replace-this-for-docker-compose

# ─── Session / Security ──────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 48 (minimum 32 characters)
SESSION_SECRET=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://your-domain.example
# Optional additional trusted front-end origins, comma-separated.
CORS_ORIGINS=

# ─── Gmail API OAuth (HTTPS; no SMTP/App Passwords) ─────────────────────────
# Create OAuth credentials and refresh tokens for each Gmail sender.
# Store all secrets in Railway/Render environment settings, never in GitHub.
NOTIFICATION_GMAIL_CLIENT_ID=
NOTIFICATION_GMAIL_CLIENT_SECRET=
NOTIFICATION_GMAIL_REFRESH_TOKEN=
MAIN_SYSTEM_EMAIL=info.avenqorabank@gmail.com
MAIN_SYSTEM_EMAIL_SENDER_NAME=Avenqora Bank

PASSWORD_RESET_GMAIL_CLIENT_ID=
PASSWORD_RESET_GMAIL_CLIENT_SECRET=
PASSWORD_RESET_GMAIL_REFRESH_TOKEN=
PASSWORD_RESET_EMAIL=pavenqorabank@gmail.com
PASSWORD_RESET_EMAIL_SENDER_NAME=Avenqora Bank

# Optional customer-support reply address (not used as the password-reset sender when PASSWORD_RESET_EMAIL is set).
CUSTOMER_SUPPORT_EMAIL=
CUSTOMER_SUPPORT_EMAIL_SENDER_NAME=

# ─── Private customer document storage ───────────────────────────────────────
# Local development default. Hosted deployments must set this to a durable mounted volume path.
# Ephemeral container filesystems can permanently lose customer KYC documents.
UPLOAD_DIR=./data/uploads

# ─── Customer Support Widget ──────────────────────────────────────────────────
# The embed code is pre-configured in client/src/config.ts from your export.
# To update the widget: edit WEBSITE_CONFIG.liveChatCode in config.ts.
# The widget loads from the third-party CDN directly — no server config needed.
