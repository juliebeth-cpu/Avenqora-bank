{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "client/src/*"
      ]
    }
  },
  "include": [
    "client/src",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "server"
  ]
}